from typing import Any

class SSHResult:
    stdout: str
    stderr: str
    rc: int | None

class HostKeyPolicy:
    Disabled: HostKeyPolicy
    AcceptNew: HostKeyPolicy
    Strict: HostKeyPolicy

class SSHClient:
    @staticmethod
    def connect(host: str, port: int, timeout: float | None = 30.0, host_key_policy: Any = ...) -> SSHClient: ...
    @property
    def latest_result(self) -> SSHResult: ...
    def authenticate(self, username: str, password: str | None = None) -> None: ...
    def exec(self, cmd: str, timeout: float | None = None) -> SSHResult: ...
    def disconnect(self) -> None: ...
    def __enter__(self) -> SSHClient: ...
    def __exit__(self, *args: object) -> None: ...

class AsyncSSHClient:
    @staticmethod
    async def connect(host: str, port: int, timeout: float | None = 30.0, host_key_policy: Any = ...) -> AsyncSSHClient: ...
    @property
    def latest_result(self) -> SSHResult: ...
    async def authenticate(self, username: str, password: str | None = None) -> None: ...
    async def exec(self, cmd: str, timeout: float | None = None) -> SSHResult: ...
    async def disconnect(self) -> None: ...
    async def __aenter__(self) -> AsyncSSHClient: ...
    async def __aexit__(self, *args: object) -> None: ...

class SSHError(RuntimeError): ...
class NotConnected(SSHError): ...
class Timeout(SSHError): ...
class PasswordRequired(SSHError): ...
class AuthenticationRequired(SSHError): ...
class AuthenticationFailed(SSHError): ...
class Connect(SSHError): ...
class Handshake(SSHError): ...
class ConnectionLost(SSHError): ...
class Agent(SSHError): ...
class SSH2(SSHError): ...
class HostKey(SSHError): ...
class Command(SSHError): ...
class NoHome(SSHError): ...
class HostKeyChanged(SSHError): ...
class HostKeyUnknown(SSHError): ...
class KnownHostsUnreadable(SSHError): ...
class KnownHostsPathRequired(SSHError): ...
