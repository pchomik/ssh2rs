from typing import Any, Self

class SSHResult:
    stdout: str
    stderr: str
    rc: int | None

class SSHClient:
    @staticmethod
    def connect(addr: str, port: int, host_key_policy: Any = ...) -> SSHClient: ...
    def authenticate(self, user: str, password: str | None = None) -> None: ...
    def exec(self, cmd: str) -> SSHResult: ...
    def disconnect(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

class AsyncSSHClient:
    @staticmethod
    async def connect(addr: str, port: int, host_key_policy: Any = ...) -> AsyncSSHClient: ...
    async def authenticate(self, user: str, password: str | None = None) -> None: ...
    async def exec(self, cmd: str) -> SSHResult: ...
    async def disconnect(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(self, *args: object) -> None: ...

class SSHError(RuntimeError): ...
class NotConnected(SSHError): ...
class PasswordRequired(SSHError): ...
class AuthenticationRequired(SSHError): ...
class AuthenticationFailed(SSHError): ...
class Connect(SSHError): ...
class Handshake(SSHError): ...
class ConnectionLost(SSHError): ...
class Agent(SSHError): ...
class SSH2(SSHError): ...
class HostKey(SSHError): ...
class Command(SSHError): ...
class NoHome(SSHError): ...
class HostKeyChanged(SSHError): ...
class HostKeyUnknown(SSHError): ...
class KnownHostsUnreadable(SSHError): ...
class KnownHostsPathRequired(SSHError): ...
